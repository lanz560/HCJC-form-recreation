{
  "name": "hcjc-form-recreation",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm run build && concurrently -k -n css,serve \"tailwindcss -i ./src/style.css -o ./dist/style.css --watch\" \"node scripts/dev-server.mjs\"",
    "build": "prisma generate && tailwindcss -i ./src/style.css -o ./dist/style.css --minify",
    "start": "node scripts/dev-server.mjs",
    "test": "node check.mjs && node --test tests/*.test.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "prisma": "^7.10.1",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10"
  }
}
